# ==============================================================================
# Gideon - Configurazione Opzionale (.env)
# Rinominare questo file in .env per personalizzare i parametri di esecuzione.
# Tutti i valori hanno già dei default ragionevoli e funzionano senza modifiche.
# ==============================================================================

# Percorso personalizzato per llama-server.exe (se non rilevato automaticamente)
# LLAMA_EXE=C:\Users\username\AppData\Local\Microsoft\WinGet\Packages\ggml.llamacpp_Microsoft.Winget.Source_8wekyb3d8bbwe\llama-server.exe

# Lunghezza del contesto in token (default: 32768)
# CTX=32768

# Abilita/disabilita il reasoning (thinking) del modello (1 = attivo, 0 = disattivo)
# ENABLE_THINKING=1

# Motori di Ricerca Web (uno tra Brave, SearXNG, o DuckDuckGo integrato)
# - Brave Search API (opzionale): https://brave.com/search/api/
# BRAVE_API_KEY=tua_chiave_brave_qui
# - Oppure istanza SearXNG locale/remota:
# SEARXNG_URL=http://localhost:8080
# - Regione e lingua per i risultati di ricerca (default: it-it):
# WEB_REGION=it-it
# - Numero di pagine da approfondire leggendo l'HTML completo (default: 2):
# WEB_DEEP_RESULTS=2

# Limite massimo di pagine analizzabili da un singolo PDF (default: 20)
# MAX_OCR_PAGES=20

